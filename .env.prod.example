# e-Rakshak Production Environment Variables
# Copy this file to .env.prod and replace the values securely

# PostgreSQL Password (must match POSTGRES_PASSWORD in docker-compose.prod.yml if changed)
POSTGRES_PASSWORD=erakshak_prod_secure_password

# Database URL for SQLAlchemy
DATABASE_URL=postgresql+psycopg://erakshak:erakshak_prod_secure_password@db:5432/erakshak

# Redis URL for Celery and websockets
REDIS_URL=redis://redis:6379/0

# JWT Security
# Generate a strong 32+ char random string
JWT_SECRET=your_super_secret_production_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# API Keys
# Get this from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Ollama Base URL (if using external Ollama or running on host machine)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# CORS Allowed Origins
# Comma-separated list of allowed origins (e.g., https://erakshak.com,https://api.erakshak.com)
CORS_ORIGINS=*

# Debug mode (disable in production)
DEBUG=False
