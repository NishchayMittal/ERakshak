# e-Rakshak Production Environment Variables
# Copy this file to .env.prod and fill in the values

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_PASSWORD=erakshak_prod_secure_password

# ── Database URL (must use the same password as above) ─────
DATABASE_URL=postgresql+psycopg://erakshak:erakshak_prod_secure_password@db:5432/erakshak

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT Security ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── API Keys ────────────────────────────────────────────────
# Groq (https://console.groq.com)
GROQ_API_KEY=

# Google Cloud Vision (for reverse image search connector)
# Leave empty to disable the connector
GOOGLE_APPLICATION_CREDENTIALS=

# ── Ollama (optional, for local AI narratives) ──────────────
# Uncomment and set if running Ollama on the host machine
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Example: https://erakshak.com,https://www.erakshak.com
CORS_ORIGINS=*

# ── Frontend Build Args ────────────────────────────────────
# These are baked into the frontend at Docker build time
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# ── Debug Mode ──────────────────────────────────────────────
# MUST be False in production
DEBUG=False
